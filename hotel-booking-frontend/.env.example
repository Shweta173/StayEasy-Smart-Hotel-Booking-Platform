# API Configuration
# Backend Laravel API URL
REACT_APP_API_URL=http://127.0.0.1:8000/api
REACT_APP_STORAGE_URL=http://127.0.0.1:8000/storage

# Stripe Configuration
# Get your key from: https://dashboard.stripe.com/test/apikeys
REACT_APP_STRIPE_KEY=pk_test_your_stripe_publishable_key_here

# Booking Configuration
REACT_APP_HOLD_EXPIRY_MINUTES=15
REACT_APP_PAYMENT_POLLING_INTERVAL=2000
REACT_APP_PAYMENT_POLLING_MAX_ATTEMPTS=15

# Development Settings
FAST_REFRESH=true
BROWSER=none
GENERATE_SOURCEMAP=false
REACT_APP_NO_CACHE=true
DISABLE_ESLINT_PLUGIN=true
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000
